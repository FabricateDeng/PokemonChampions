.teams-page {
  padding-bottom: 20rpx;
}

.teams-hero {
  position: relative;
  margin-top: 18rpx;
  padding: 34rpx 30rpx 28rpx;
  border-radius: 34rpx;
  overflow: hidden;
  background:
    radial-gradient(420rpx 260rpx at 100% 0%, rgba(77, 224, 193, 0.14), transparent 70%),
    linear-gradient(150deg, #141d2d, #0c1320);
  border: 1rpx solid rgba(77, 224, 193, 0.14);
}

.teams-kicker {
  font-size: 16rpx;
  letter-spacing: 3rpx;
  font-weight: 700;
  color: rgba(77, 224, 193, 0.7);
}

.teams-title {
  display: block;
  margin-top: 6rpx;
  font-size: 48rpx;
  line-height: 58rpx;
  font-weight: 800;
  color: #f4fffc;
}

.teams-sub {
  display: block;
  margin-top: 10rpx;
  font-size: 21rpx;
  line-height: 32rpx;
  color: #93a1b5;
}

.teams-actions {
  display: flex;
  margin-top: 24rpx;
}

.create-btn {
  height: 66rpx;
  padding: 0 24rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 23rpx;
  font-weight: 700;
  color: #10130a;
  background: linear-gradient(135deg, #7df0d7, #4de0c1);
  box-shadow: 0 10rpx 26rpx rgba(77, 224, 193, 0.16);
}

.create-plus {
  font-size: 32rpx;
  line-height: 1;
}

.team-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 22rpx;
}

.team-card {
  padding: 22rpx 20rpx 16rpx;
  border-radius: 26rpx;
  background: #111827;
  border: 1rpx solid rgba(255, 255, 255, 0.075);
}

.team-card-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.team-title-wrap {
  min-width: 0;
}

.team-name {
  display: block;
  font-size: 29rpx;
  line-height: 38rpx;
  font-weight: 750;
  color: #f1f5fb;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.team-meta {
  display: block;
  margin-top: 4rpx;
  font-size: 18rpx;
  color: #6f7b8f;
}

.team-delete {
  height: 42rpx;
  padding: 0 13rpx;
  flex-shrink: 0;
  border-radius: 12rpx;
  font-size: 18rpx;
  line-height: 40rpx;
  color: #ff8b96;
  background: rgba(255, 92, 108, 0.07);
  border: 1rpx solid rgba(255, 92, 108, 0.18);
}

.team-sprites {
  display: flex;
  align-items: flex-end;
  gap: 8rpx;
  min-height: 104rpx;
  margin-top: 14rpx;
}

.team-sprite-cell {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.team-sprite {
  width: 82rpx;
  height: 82rpx;
}

.team-sprite-name {
  width: 100%;
  margin-top: 2rpx;
  font-size: 15rpx;
  color: #7f8ba0;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.team-empty-hint {
  font-size: 20rpx;
  color: #5d697d;
  padding: 26rpx 0;
}

.team-card-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 14rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.055);
  font-size: 19rpx;
  color: #8ef1dd;
}

.team-arrow {
  font-size: 24rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 20rpx 60rpx;
}

.empty-orb {
  position: relative;
  width: 138rpx;
  height: 138rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.12);
}

.empty-orb::before {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  height: 2rpx;
  background: rgba(255, 255, 255, 0.12);
}

.empty-orb-line {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 42rpx;
  height: 42rpx;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.16);
  background: #070b14;
}

.empty-orb-core {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 12rpx;
  height: 12rpx;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  background: #4de0c1;
}

.empty-title {
  margin-top: 28rpx;
  font-size: 29rpx;
  font-weight: 700;
  color: #dfe6f1;
}

.empty-sub {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #748095;
  text-align: center;
}

.empty-btn {
  margin-top: 26rpx;
  height: 62rpx;
  padding: 0 26rpx;
  border-radius: 17rpx;
  font-size: 22rpx;
  line-height: 60rpx;
  color: #10130a;
  font-weight: 700;
  background: linear-gradient(135deg, #7df0d7, #4de0c1);
}

.teams-note {
  padding: 24rpx 4rpx calc(30rpx + env(safe-area-inset-bottom));
  font-size: 18rpx;
  line-height: 29rpx;
  color: #596579;
}
