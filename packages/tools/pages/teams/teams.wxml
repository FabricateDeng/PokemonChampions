<nav-bar title="我的队伍" back="{{true}}" />

<view class="page teams-page">
  <view class="page-pad">
    <view class="teams-hero">
      <view class="teams-kicker">TEAM BUILDER</view>
      <text class="teams-title">我的队伍</text>
      <text class="teams-sub">最多 6 只 · 配置能力值与招式 · 本地保存</text>
      <view class="teams-actions">
        <view class="create-btn press" bindtap="createTeam" hover-class="press-hover">
          <text class="create-plus">+</text>
          <text>新建队伍</text>
        </view>
      </view>
    </view>

    <view wx:if="{{!hasTeams}}" class="empty">
      <view class="empty-orb">
        <view class="empty-orb-line"></view>
        <view class="empty-orb-core"></view>
      </view>
      <text class="empty-title">还没有队伍</text>
      <text class="empty-sub">创建第一支队伍，配置宝可梦、招式与努力值</text>
      <view class="empty-btn press" bindtap="createTeam" hover-class="press-hover">新建队伍</view>
    </view>

    <view wx:else class="team-list">
      <view
        wx:for="{{teams}}"
        wx:key="id"
        class="team-card"
        data-id="{{item.id}}"
        bindtap="openTeam"
        hover-class="press-hover"
      >
        <view class="team-card-head">
          <view class="team-title-wrap">
            <text class="team-name">{{item.name}}</text>
            <text class="team-meta">{{item.count}} / 6 只 · 更新于 {{item.date}}</text>
          </view>
          <view
            class="team-delete"
            data-id="{{item.id}}"
            data-name="{{item.name}}"
            catchtap="deleteTeam"
          >删除</view>
        </view>

        <view class="team-sprites">
          <block wx:for="{{item.members}}" wx:for-item="m" wx:key="key">
            <view class="team-sprite-cell">
              <image class="team-sprite" src="{{m.sprite}}" mode="aspectFit" lazy-load />
              <text class="team-sprite-name">{{m.name}}</text>
            </view>
          </block>
          <view wx:if="{{item.count === 0}}" class="team-empty-hint">点击进入并添加宝可梦</view>
        </view>

        <view class="team-card-foot">
          <text>编辑队伍</text>
          <text class="team-arrow">→</text>
        </view>
      </view>
    </view>

    <view class="teams-note">
      <text>队伍配置保存在本机，不会上传服务器。当前仅支持 Champions 的 Lv.50 / IV 31 / 0–32 SP 体系。</text>
    </view>
  </view>
</view>
