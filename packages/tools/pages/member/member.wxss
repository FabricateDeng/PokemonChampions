.member-page {
  padding-bottom: 20rpx;
}

.member-hero {
  position: relative;
  margin-top: 18rpx;
  padding: 22rpx 24rpx 28rpx;
  border-radius: 32rpx;
  overflow: hidden;
  background:
    radial-gradient(360rpx 240rpx at 100% 0%, rgba(77, 224, 193, 0.12), transparent 70%),
    linear-gradient(160deg, #141d2d, #0c1320);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.member-hero-top {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.member-hero-types {
  display: flex;
  gap: 7rpx;
}

.hero-type {
  height: 32rpx;
  padding: 0 10rpx;
  border-radius: 8rpx;
  border: 1rpx solid;
  font-size: 16rpx;
  line-height: 32rpx;
  font-weight: 600;
}

.team-label {
  font-size: 17rpx;
  color: #657186;
  max-width: 260rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-sprite {
  width: 220rpx;
  height: 220rpx;
  margin-top: 4rpx;
  filter: drop-shadow(0 14rpx 18rpx rgba(0, 0, 0, 0.3));
}

.hero-name {
  margin-top: 2rpx;
  font-size: 40rpx;
  line-height: 48rpx;
  font-weight: 800;
  color: #fffdf5;
}

.hero-dex {
  margin-top: 3rpx;
  font-size: 18rpx;
  color: #657186;
}

.stat-panel,
.config-panel {
  margin-top: 16rpx;
  padding: 22rpx 20rpx;
  border-radius: 24rpx;
  background: #111827;
  border: 1rpx solid rgba(255, 255, 255, 0.07);
}

.panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  margin-bottom: 16rpx;
}

.panel-note {
  font-size: 17rpx;
  color: #657186;
}

.stat-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8rpx;
}

.stat-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 4rpx 10rpx;
  border-radius: 12rpx;
  background: #0c1320;
  border: 1rpx solid rgba(255, 255, 255, 0.045);
}

.stat-label {
  font-size: 16rpx;
  color: #657186;
}

.stat-value {
  margin-top: 2rpx;
  font-size: 29rpx;
  line-height: 34rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}

.nature-note {
  margin-top: 12rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.055);
  font-size: 18rpx;
  color: #7d899d;
}

.picker-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  height: 70rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.055);
}

.picker-row:last-child {
  border-bottom: none;
}

.picker-label {
  width: 70rpx;
  flex-shrink: 0;
  font-size: 20rpx;
  color: #657186;
}

.picker-value {
  flex: 1;
  min-width: 0;
  font-size: 23rpx;
  color: #d6dfeb;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.picker-arrow {
  font-size: 28rpx;
  color: #5f6b7f;
}

.move-slot {
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.055);
}

.move-slot:last-child {
  border-bottom: none;
}

.move-slot-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 72rpx;
}

.move-slot-index {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  border-radius: 9rpx;
  text-align: center;
  line-height: 32rpx;
  font-size: 16rpx;
  color: #657186;
  background: rgba(255, 255, 255, 0.04);
}

.move-slot-main {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.move-slot-name {
  font-size: 22rpx;
  color: #d6dfeb;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.move-slot-name.empty {
  color: #5f6b7f;
}

.move-slot-type {
  height: 27rpx;
  padding: 0 8rpx;
  flex-shrink: 0;
  border-radius: 7rpx;
  font-size: 14rpx;
  line-height: 27rpx;
}

.sp-total {
  height: 36rpx;
  padding: 0 10rpx;
  border-radius: 9rpx;
  font-size: 17rpx;
  line-height: 36rpx;
  color: #8ff5df;
  background: rgba(77, 224, 193, 0.07);
}

.sp-total.full {
  color: #ffd84d;
  background: rgba(255, 216, 77, 0.07);
}

.sp-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.sp-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.sp-label-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.sp-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
}

.sp-label {
  font-size: 20rpx;
  color: #9eabbf;
}

.sp-controls {
  display: flex;
  align-items: center;
  gap: 9rpx;
}

.sp-btn {
  width: 46rpx;
  height: 46rpx;
  border-radius: 13rpx;
  text-align: center;
  line-height: 42rpx;
  font-size: 28rpx;
  color: #b8c3d3;
  background: rgba(255, 255, 255, 0.055);
  border: 1rpx solid rgba(255, 255, 255, 0.07);
}

.sp-value {
  width: 44rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 750;
  color: #f0f5fb;
  font-variant-numeric: tabular-nums;
}

.sp-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  margin-top: 16rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.055);
}

.sp-reset {
  height: 42rpx;
  padding: 0 12rpx;
  border-radius: 11rpx;
  font-size: 17rpx;
  line-height: 40rpx;
  color: #ff9a9a;
  background: rgba(255, 92, 108, 0.06);
  border: 1rpx solid rgba(255, 92, 108, 0.16);
}

.sp-hint {
  font-size: 16rpx;
  color: #5f6b7f;
}

.member-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  margin-top: 18rpx;
}

.calc-link {
  flex: 1;
  height: 64rpx;
  border-radius: 17rpx;
  text-align: center;
  line-height: 62rpx;
  font-size: 21rpx;
  color: #10130a;
  font-weight: 700;
  background: linear-gradient(135deg, #7df0d7, #4de0c1);
}

.remove-link {
  height: 64rpx;
  padding: 0 18rpx;
  border-radius: 17rpx;
  font-size: 20rpx;
  line-height: 62rpx;
  color: #ff8b96;
  background: rgba(255, 92, 108, 0.06);
  border: 1rpx solid rgba(255, 92, 108, 0.16);
}

.member-note {
  padding: 20rpx 4rpx calc(30rpx + env(safe-area-inset-bottom));
  font-size: 18rpx;
  line-height: 29rpx;
  color: #596579;
}
