.team-page {
  padding-bottom: 20rpx;
}

.team-hero {
  position: relative;
  margin-top: 18rpx;
  padding: 28rpx 26rpx;
  border-radius: 32rpx;
  overflow: hidden;
  background:
    radial-gradient(360rpx 220rpx at 100% 0%, rgba(255, 216, 77, 0.15), transparent 70%),
    linear-gradient(150deg, #151e2e, #0c1320);
  border: 1rpx solid rgba(255, 216, 77, 0.14);
}

.team-hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.team-hero-copy {
  flex: 1;
  min-width: 0;
}

.team-kicker {
  font-size: 15rpx;
  letter-spacing: 2.6rpx;
  font-weight: 700;
  color: rgba(255, 216, 77, 0.68);
}

.team-name-input {
  width: 100%;
  height: 62rpx;
  margin-top: 4rpx;
  font-size: 38rpx;
  font-weight: 800;
  color: #fffdf5;
}

.team-name-placeholder {
  color: #5f6b7f;
}

.team-count {
  display: block;
  margin-top: 4rpx;
  font-size: 19rpx;
  color: #7d899d;
}

.team-hero-badge {
  width: 82rpx;
  height: 82rpx;
  flex-shrink: 0;
  border-radius: 22rpx;
  text-align: center;
  line-height: 80rpx;
  font-size: 22rpx;
  font-weight: 800;
  color: #171204;
  background: linear-gradient(140deg, #ffe66f, #ffc531);
  box-shadow: 0 10rpx 26rpx rgba(255, 205, 50, 0.16);
}

.slot-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 20rpx;
}

.slot-empty {
  min-height: 104rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.02);
  border: 1rpx dashed rgba(255, 255, 255, 0.11);
}

.slot-plus {
  width: 54rpx;
  height: 54rpx;
  border-radius: 16rpx;
  text-align: center;
  line-height: 50rpx;
  font-size: 34rpx;
  font-weight: 300;
  color: #8ff5df;
  background: rgba(77, 224, 193, 0.07);
  border: 1rpx solid rgba(77, 224, 193, 0.18);
}

.slot-empty-copy {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.slot-empty-title {
  font-size: 23rpx;
  font-weight: 650;
  color: #c5d0df;
}

.slot-empty-sub {
  margin-top: 2rpx;
  font-size: 17rpx;
  color: #5f6b7f;
}

.slot-arrow {
  font-size: 26rpx;
  color: #6f7b8f;
}

.member-card {
  padding: 18rpx 18rpx 14rpx;
  border-radius: 24rpx;
  background: #111827;
  border: 1rpx solid rgba(255, 255, 255, 0.075);
}

.member-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.member-identity {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
  flex: 1;
}

.member-sprite {
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
}

.member-copy {
  min-width: 0;
}

.member-name {
  display: block;
  font-size: 27rpx;
  line-height: 35rpx;
  font-weight: 750;
  color: #f0f5fb;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.member-types {
  display: flex;
  flex-wrap: wrap;
  gap: 5rpx;
  margin-top: 7rpx;
}

.member-type {
  height: 27rpx;
  padding: 0 8rpx;
  border-radius: 7rpx;
  border: 1rpx solid;
  font-size: 15rpx;
  line-height: 27rpx;
  font-weight: 600;
}

.member-actions {
  display: flex;
  gap: 8rpx;
  flex-shrink: 0;
}

.member-edit,
.member-remove {
  height: 40rpx;
  padding: 0 11rpx;
  border-radius: 11rpx;
  font-size: 17rpx;
  line-height: 38rpx;
}

.member-edit {
  color: #8ff5df;
  background: rgba(77, 224, 193, 0.07);
  border: 1rpx solid rgba(77, 224, 193, 0.18);
}

.member-remove {
  color: #ff8b96;
  background: rgba(255, 92, 108, 0.06);
  border: 1rpx solid rgba(255, 92, 108, 0.16);
}

.member-config {
  display: flex;
  flex-wrap: wrap;
  gap: 7rpx;
  margin-top: 12rpx;
}

.config-pill {
  height: 36rpx;
  padding: 0 10rpx;
  border-radius: 9rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 17rpx;
  color: #b8c3d3;
  background: rgba(255, 255, 255, 0.035);
  border: 1rpx solid rgba(255, 255, 255, 0.055);
}

.config-label {
  color: #657186;
}

.member-moves {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
  margin-top: 10rpx;
}

.move-chip {
  height: 30rpx;
  padding: 0 9rpx;
  border-radius: 8rpx;
  font-size: 16rpx;
  line-height: 30rpx;
  color: #9fb0c5;
  background: rgba(90, 150, 255, 0.07);
}

.move-chip.empty-chip {
  color: #657186;
  background: rgba(255, 255, 255, 0.03);
}

.member-stats {
  display: flex;
  gap: 5rpx;
  margin-top: 12rpx;
  padding-top: 11rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.055);
}

.stat-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 5rpx 2rpx;
  border-radius: 7rpx;
  background: rgba(255, 255, 255, 0.025);
}

.stat-label {
  font-size: 14rpx;
  color: #657186;
}

.stat-value {
  margin-top: 1rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #c8d3e1;
  font-variant-numeric: tabular-nums;
}

.calc-btn {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
  padding: 20rpx 24rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, rgba(77, 224, 193, 0.16), rgba(77, 224, 193, 0.05));
  border: 1rpx solid rgba(77, 224, 193, 0.25);
}

.calc-kicker {
  display: block;
  font-size: 14rpx;
  letter-spacing: 2rpx;
  font-weight: 700;
  color: rgba(77, 224, 193, 0.7);
}

.calc-title {
  display: block;
  margin-top: 3rpx;
  font-size: 25rpx;
  font-weight: 700;
  color: #d8fff7;
}

.calc-arrow {
  font-size: 30rpx;
  color: #8ff5df;
}

.team-note {
  padding: 22rpx 4rpx calc(30rpx + env(safe-area-inset-bottom));
  font-size: 18rpx;
  line-height: 29rpx;
  color: #596579;
}
