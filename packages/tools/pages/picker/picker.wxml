<nav-bar title="选择宝可梦" back="{{true}}" />

<view class="page picker-page">
  <view class="page-pad">
    <view class="picker-head">
      <text class="picker-kicker">ADD TO TEAM</text>
      <text class="picker-title">选择宝可梦</text>
      <text class="picker-sub">{{teamName}} · {{slotLabel}}</text>
    </view>

    <view class="search-box">
      <view class="search-icon"></view>
      <input
        class="search-input"
        value="{{query}}"
        placeholder="搜索名称 / 图鉴编号"
        placeholder-class="search-placeholder"
        bindinput="onSearchInput"
      />
      <view wx:if="{{query}}" class="search-clear" bindtap="clearSearch">×</view>
    </view>

    <scroll-view class="type-rail" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="type-rail-inner">
        <view
          wx:for="{{typeList}}"
          wx:key="key"
          class="type-chip"
          data-key="{{item.key}}"
          bindtap="onTypeTap"
          style="background:{{typeKey === item.key ? item.color : 'rgba(255,255,255,0.045)'}};border-color:{{typeKey === item.key ? item.color : 'rgba(255,255,255,0.09)'}};color:{{typeKey === item.key ? item.textOn : '#c9d2e0'}};"
        >{{item.name}}</view>
      </view>
    </scroll-view>

    <view class="result-bar">
      <text class="result-count">{{resultCount}}</text>
      <text class="result-unit">只可选宝可梦</text>
    </view>
  </view>

  <view class="pick-list page-pad">
    <view
      wx:for="{{list}}"
      wx:key="key"
      class="pick-row"
      data-key="{{item.key}}"
      bindtap="select"
      hover-class="press-hover"
    >
      <text class="pick-dex">{{item.dexLabel}}</text>
      <image class="pick-sprite" src="{{item.sprite}}" mode="aspectFit" lazy-load />
      <view class="pick-info">
        <view class="pick-name-line">
          <text class="pick-name">{{item.name}}</text>
          <text wx:if="{{item.formLabel}}" class="pick-form">{{item.formLabel}}</text>
        </view>
        <view class="pick-types">
          <view
            wx:for="{{item.typesInfo}}"
            wx:for-item="t"
            wx:key="key"
            class="pick-type"
            style="color:{{t.color}};background:{{t.bg}};border-color:{{t.border}};"
          >{{t.name}}</view>
        </view>
      </view>
      <text class="pick-total">BST {{item.total}}</text>
    </view>
  </view>

  <view wx:if="{{!list.length}}" class="empty">
    <text class="empty-title">没有匹配的宝可梦</text>
    <text class="empty-sub">试试更换关键词或属性</text>
  </view>

  <view wx:if="{{list.length}}" class="list-foot">
    <text wx:if="{{hasMore}}">继续上滑加载更多</text>
    <text wx:else>共 {{resultCount}} 只</text>
  </view>
</view>
