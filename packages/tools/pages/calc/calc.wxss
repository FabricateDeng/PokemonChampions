.calc-page {
  padding-bottom: 20rpx;
}

.calc-head {
  margin-top: 20rpx;
}

.calc-kicker {
  font-size: 15rpx;
  letter-spacing: 2.6rpx;
  font-weight: 700;
  color: rgba(255, 216, 77, 0.68);
}

.calc-title {
  display: block;
  margin-top: 4rpx;
  font-size: 42rpx;
  line-height: 50rpx;
  font-weight: 800;
  color: #fffdf5;
}

.calc-sub {
  display: block;
  margin-top: 5rpx;
  font-size: 20rpx;
  line-height: 30rpx;
  color: #7d899d;
}

.team-select {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 18rpx;
  padding: 14rpx 18rpx;
  border-radius: 18rpx;
  background: #111827;
  border: 1rpx solid rgba(255, 255, 255, 0.07);
}

.team-select-label {
  font-size: 18rpx;
  color: #657186;
}

.team-select-value {
  font-size: 21rpx;
  color: #d6dfeb;
}

.team-edit-link {
  margin-left: auto;
  font-size: 18rpx;
  color: #8ff5df;
}

.chevron {
  margin-left: 5rpx;
  font-size: 20rpx;
  color: #657186;
}

.side-card {
  margin-top: 14rpx;
  padding: 18rpx;
  border-radius: 24rpx;
  background: #111827;
  border: 1rpx solid rgba(255, 255, 255, 0.07);
}

.attacker-card {
  border-color: rgba(255, 216, 77, 0.16);
}

.defender-card {
  border-color: rgba(77, 224, 193, 0.14);
}

.side-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.side-tag {
  height: 34rpx;
  padding: 0 11rpx;
  border-radius: 9rpx;
  font-size: 17rpx;
  line-height: 34rpx;
  font-weight: 700;
}

.side-tag.attacker {
  color: #171204;
  background: #ffd84d;
}

.side-tag.defender {
  color: #10130a;
  background: #4de0c1;
}

.side-select {
  font-size: 18rpx;
  color: #8e9aae;
}

.side-body {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 8rpx;
}

.side-sprite {
  width: 100rpx;
  height: 100rpx;
  flex-shrink: 0;
}

.side-info {
  flex: 1;
  min-width: 0;
}

.side-name {
  display: block;
  font-size: 29rpx;
  line-height: 37rpx;
  font-weight: 750;
  color: #f0f5fb;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.side-types {
  display: flex;
  gap: 5rpx;
  margin-top: 5rpx;
}

.side-type {
  height: 26rpx;
  padding: 0 7rpx;
  border-radius: 7rpx;
  border: 1rpx solid;
  font-size: 14rpx;
  line-height: 26rpx;
  font-weight: 600;
}

.side-config {
  display: block;
  margin-top: 7rpx;
  font-size: 17rpx;
  color: #7d899d;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.side-stats {
  display: flex;
  gap: 5rpx;
  margin-top: 14rpx;
  padding-top: 11rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.055);
}

.side-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 5rpx 2rpx;
  border-radius: 7rpx;
  background: rgba(255, 255, 255, 0.025);
}

.stat-label {
  font-size: 13rpx;
  color: #657186;
}

.stat-value {
  margin-top: 1rpx;
  font-size: 19rpx;
  font-weight: 700;
  color: #c8d3e1;
  font-variant-numeric: tabular-nums;
}

.field-panel {
  margin-top: 14rpx;
  padding: 8rpx 18rpx 16rpx;
  border-radius: 24rpx;
  background: #111827;
  border: 1rpx solid rgba(255, 255, 255, 0.07);
}

.field-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 64rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.055);
}

.field-label {
  font-size: 19rpx;
  color: #7d899d;
}

.field-value {
  font-size: 21rpx;
  color: #d6dfeb;
}

.switch-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 6rpx 18rpx;
  padding-top: 10rpx;
}

.switch-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 18rpx;
  color: #9eabbf;
}

.result-card {
  margin-top: 16rpx;
  padding: 22rpx 20rpx;
  border-radius: 26rpx;
  background:
    radial-gradient(320rpx 180rpx at 100% 0%, rgba(255, 216, 77, 0.12), transparent 70%),
    #111827;
  border: 1rpx solid rgba(255, 216, 77, 0.18);
}

.result-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.result-move {
  display: block;
  font-size: 27rpx;
  font-weight: 750;
  color: #f0f5fb;
}

.result-eff {
  display: block;
  margin-top: 4rpx;
  font-size: 18rpx;
  color: #8e9aae;
}

.result-cat {
  height: 32rpx;
  padding: 0 10rpx;
  border-radius: 8rpx;
  font-size: 16rpx;
  line-height: 32rpx;
  color: #ffd84d;
  background: rgba(255, 216, 77, 0.07);
}

.result-damage {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-top: 16rpx;
}

.result-number {
  font-size: 48rpx;
  line-height: 54rpx;
  font-weight: 850;
  color: #ffd84d;
  font-variant-numeric: tabular-nums;
}

.result-percent {
  font-size: 26rpx;
  font-weight: 700;
  color: #dbe3ee;
}

.result-bar {
  height: 12rpx;
  margin-top: 10rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.06);
}

.result-bar-fill {
  height: 100%;
  border-radius: 12rpx;
  background: linear-gradient(90deg, rgba(255, 216, 77, 0.5), #ffd84d);
}

.result-meta {
  display: flex;
  gap: 28rpx;
  margin-top: 14rpx;
}

.meta-label {
  font-size: 17rpx;
  color: #657186;
}

.meta-value {
  margin-left: 7rpx;
  font-size: 19rpx;
  color: #c8d3e1;
}

.result-notes {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  margin-top: 13rpx;
  padding-top: 11rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.055);
  font-size: 17rpx;
  line-height: 27rpx;
  color: #7d899d;
}

.result-empty {
  margin-top: 16rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  text-align: center;
  font-size: 20rpx;
  color: #7d899d;
  background: #111827;
  border: 1rpx solid rgba(255, 255, 255, 0.07);
}

.calc-note {
  padding: 20rpx 4rpx calc(30rpx + env(safe-area-inset-bottom));
  font-size: 17rpx;
  line-height: 28rpx;
  color: #596579;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 20rpx 60rpx;
}

.empty-orb {
  width: 130rpx;
  height: 130rpx;
  border-radius: 50%;
  text-align: center;
  line-height: 126rpx;
  font-size: 48rpx;
  font-weight: 800;
  color: #ffd84d;
  background: rgba(255, 216, 77, 0.05);
  border: 2rpx solid rgba(255, 216, 77, 0.16);
}

.empty-title {
  margin-top: 26rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #dfe6f1;
}

.empty-sub {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #748095;
}

.empty-btn {
  margin-top: 24rpx;
  height: 62rpx;
  padding: 0 26rpx;
  border-radius: 17rpx;
  font-size: 22rpx;
  line-height: 60rpx;
  color: #10130a;
  font-weight: 700;
  background: linear-gradient(135deg, #7df0d7, #4de0c1);
}
