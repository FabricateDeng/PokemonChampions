/* 宝可梦详情：紧凑头部 + 页面分区 + 固定底栏 */

.hero {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0 24rpx;
}

.hero-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.hero-types {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: wrap;
}

.hero-name {
  font-size: 40rpx;
  line-height: 1.2;
  font-weight: 700;
  color: var(--text);
}

.hero-meta {
  font-size: 24rpx;
  color: var(--text-3);
}

.hero-sprite {
  width: 176rpx;
  height: 176rpx;
  flex-shrink: 0;
}

.tabs {
  position: sticky;
  z-index: 20;
  padding: 12rpx 0 16rpx;
  background: var(--bg);
}

/* ---------------------------------------------------------------- 区块 */

.bst {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.bst-num {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--brand);
}

.bst-label {
  font-size: 22rpx;
  color: var(--text-3);
}

/* ---------------------------------------------------------------- 种族值 */

.stats {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.stat {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.stat-label {
  width: 72rpx;
  font-size: 24rpx;
  color: var(--text-2);
  flex-shrink: 0;
}

.stat-value {
  width: 64rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
  text-align: right;
  flex-shrink: 0;
}

.stat-bar {
  flex: 1;
  min-width: 0;
}

/* 六条数值条只做数据可视化，压一档亮度避免抢主按钮（R6.2） */
.stat-bar .bar-fill {
  opacity: 0.72;
}

.rank-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--line);
}

.rank-num {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--brand);
}

/* ---------------------------------------------------------------- 属性相性 */

.matchups {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.mu {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.mu-label {
  width: 118rpx;
  flex-shrink: 0;
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.mu-mult {
  font-size: 24rpx;
  font-weight: 700;
}

.mu-name {
  font-size: 22rpx;
  color: var(--text-3);
}

.mu-label.weak .mu-mult {
  color: var(--danger);
}

.mu-label.resist .mu-mult {
  color: var(--success);
}

.mu-label.immune .mu-mult {
  color: var(--text-2);
}

.mu-types {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

/* ---------------------------------------------------------------- 特性 */

.abilities {
  display: flex;
  flex-direction: column;
}

.ability {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.ability:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.ability-index {
  width: 36rpx;
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--text-3);
  line-height: 1.5;
}

.ability-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.ability-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
}

.ability-desc {
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--text-2);
}

/* ---------------------------------------------------------------- 招式 */

.move-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 8rpx 0 16rpx;
}

/* ---------------------------------------------------------------- 使用率 */

.usage-head {
  padding: 8rpx 0 16rpx;
}

.usage-sum {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.usage-sum-main {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.usage-rank {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
}

.usage-pct {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--brand);
}

.ubar {
  padding: 12rpx 0;
}

.ubar-top {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 8rpx;
}

.ubar-name {
  font-size: 26rpx;
  color: var(--text);
  flex: 1;
  min-width: 0;
}

.ubar-pct {
  font-size: 24rpx;
  color: var(--text-2);
  flex-shrink: 0;
}

.spread {
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.spread:last-of-type {
  border-bottom: none;
}

.spread-cells {
  display: flex;
  gap: 8rpx;
  margin-top: 4rpx;
}

.spread-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
  padding: 8rpx 0;
  border-radius: 10rpx;
  background: var(--surface-2);
}

.spread-label {
  font-size: 22rpx;
  color: var(--text-3);
}

.spread-value {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
}
