<nav-bar title="{{mon.name || '宝可梦详情'}}" back="{{true}}" />

<view wx:if="{{notFound}}" class="page">
  <empty-state
    icon="search"
    title="没有找到这只宝可梦"
    desc="它可能不在当前图鉴数据中"
    actionText="返回图鉴"
    bind:action="goHome"
  />
</view>

<view wx:else class="page">
  <view class="pad">
    <view class="hero">
      <view class="hero-info">
        <text class="hero-name">{{mon.name}}</text>

        <view class="hero-types">
          <view
            wx:for="{{mon.typesInfo}}"
            wx:for-item="t"
            wx:key="key"
            class="tag"
            style="color:{{t.color}};background:{{t.bg}};"
          >{{t.name}}</view>
          <text wx:if="{{mon.formShort}}" class="tag-badge">{{mon.formLabel}}</text>
        </view>

        <text class="hero-meta num">{{mon.dexLabel}} · 第 {{mon.gen}} 世代 · 种族值 {{mon.total}} · 规则 {{mon.reg}}</text>
      </view>

      <image class="hero-sprite" src="{{mon.sprite}}" mode="aspectFit" />
    </view>
  </view>

  <view class="tabs" style="top:{{navTotalHeight}}px;">
    <view class="pad">
      <segmented items="{{tabs}}" active="{{activeTab}}" bind:change="onTab" />
    </view>
  </view>

  <!-- 数据 -->
  <view wx:if="{{activeTab === 'stats'}}" class="pad">
    <view class="card block">
      <view class="block-head">
        <text class="t-section">种族值</text>
        <view class="bst">
          <text class="bst-num num">{{mon.total}}</text>
          <text class="bst-label">总和</text>
        </view>
      </view>

      <view class="stats">
        <view wx:for="{{stats}}" wx:key="key" class="stat">
          <text class="stat-label">{{item.label}}</text>
          <text class="stat-value num">{{item.value}}</text>
          <view class="bar stat-bar">
            <view class="bar-fill" style="width:{{item.percent}};"></view>
          </view>
        </view>
      </view>

      <view class="rank-row">
        <text class="t-mini">种族值排名</text>
        <text class="rank-num num">#{{totalRank}}</text>
        <text class="t-mini">/ {{totalCount}} · 含全部形态</text>
      </view>
    </view>

    <view class="card block">
      <view class="block-head">
        <text class="t-section">属性相性</text>
        <text class="t-mini">不计特性与道具</text>
      </view>

      <view class="matchups">
        <view wx:for="{{matchups}}" wx:key="key" class="mu">
          <view class="mu-label {{item.tone}}">
            <text class="mu-mult num">{{item.mult}}</text>
            <text class="mu-name">{{item.label}}</text>
          </view>
          <view class="mu-types">
            <view
              wx:for="{{item.types}}"
              wx:for-item="t"
              wx:key="key"
              class="tag"
              style="color:{{t.color}};background:{{t.bg}};"
            >{{t.name}}</view>
          </view>
        </view>
      </view>
    </view>

    <view class="card block">
      <view class="block-head">
        <text class="t-section">特性</text>
        <text class="t-mini">{{abilities.length}} 个</text>
      </view>

      <view class="abilities">
        <view wx:for="{{abilities}}" wx:key="key" class="ability">
          <text class="ability-index num">{{item.index}}</text>
          <view class="ability-main">
            <text class="ability-name">{{item.name}}</text>
            <text class="ability-desc">{{item.desc}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 招式 -->
  <view wx:if="{{activeTab === 'moves'}}" class="pad">
    <view class="move-bar">
      <view class="chip-group">
        <view
          wx:for="{{moveCats}}"
          wx:key="key"
          class="chip chip-sm {{moveCatIndex === index ? 'chip-on' : ''}}"
          data-index="{{index}}"
          bindtap="onMoveCat"
          hover-class="press-hover"
        >{{item.name}}</view>
      </view>
      <text class="t-mini num">{{moves.length}} 个</text>
    </view>

    <view class="list">
      <view wx:for="{{moves}}" wx:key="key" class="mv">
        <view class="mv-top">
          <text class="mv-name">{{item.name}}</text>
          <view class="tag" style="color:{{item.typeColor}};background:{{item.typeBg}};">{{item.typeName}}</view>
          <text class="tag-plain">{{item.catName}}</text>
          <text wx:if="{{item.priorityText}}" class="mv-prio num">先制 {{item.priorityText}}</text>
        </view>
        <view class="mv-stats">
          <text class="mv-stat">威力 <text class="num strong">{{item.powerText}}</text></text>
          <text class="mv-stat">命中 <text class="num strong">{{item.accText}}</text></text>
          <text class="mv-stat">PP <text class="num strong">{{item.pp}}</text></text>
        </view>
        <text wx:if="{{item.desc}}" class="mv-desc clamp-2">{{item.desc}}</text>
      </view>
    </view>

    <empty-state
      wx:if="{{!moves.length}}"
      icon="ball"
      title="这个分类下没有招式"
      desc="换一个分类看看"
      actionText="查看全部招式"
      bind:action="onMoveCatReset"
    />
  </view>

  <!-- 使用率 -->
  <view wx:if="{{activeTab === 'usage'}}" class="pad">
    <view class="usage-head">
      <view class="chip-group">
        <view
          wx:for="{{usageFormats}}"
          wx:key="key"
          class="chip chip-sm {{usageFormat === item.key ? 'chip-on' : ''}}"
          data-key="{{item.key}}"
          bindtap="onUsageFormat"
          hover-class="press-hover"
        >{{item.label}}</view>
      </view>
    </view>

    <empty-state
      wx:if="{{usageEmpty}}"
      icon="ball"
      title="暂无配置使用率样本"
      desc="该宝可梦未进入当前环境 TOP50，暂未收录配置统计"
    />

    <empty-state
      wx:elif="{{usageFormatEmpty}}"
      icon="ball"
      title="该赛制暂无样本"
      desc="换一个单打 / 双打视角试试"
    />

    <block wx:else>
      <view class="card usage-sum">
        <view class="usage-sum-main">
          <text class="usage-rank num">{{usageSummary.rankText}}</text>
          <text class="usage-pct num">{{usageSummary.pctText}}</text>
        </view>
        <text class="t-mini">使用率 · {{usageSummary.sourceText}}</text>
        <text class="t-mini">{{usageSummary.sampleText}}</text>
      </view>

      <view wx:for="{{usageSections}}" wx:key="key" class="card block">
        <view class="block-head">
          <text class="t-section">{{item.title}}</text>
          <text class="t-mini">{{item.note}}</text>
        </view>

        <block wx:if="{{item.kind === 'bar'}}">
          <view wx:for="{{item.items}}" wx:for-item="row" wx:key="name" class="ubar">
            <view class="ubar-top">
              <text class="ubar-name ellipsis">{{row.name}}</text>
              <view wx:if="{{row.typeName}}" class="tag" style="color:{{row.typeColor}};background:{{row.typeBg}};">{{row.typeName}}</view>
              <text class="ubar-pct num">{{row.pctText}}</text>
            </view>
            <view class="bar">
              <view class="bar-fill" style="width:{{row.width}};"></view>
            </view>
          </view>
        </block>

        <block wx:else>
          <view wx:for="{{item.items}}" wx:for-item="row" wx:key="key" class="spread">
            <view class="ubar-top">
              <text class="ubar-name">{{row.name}}</text>
              <text class="ubar-pct num">{{row.pctText}}</text>
            </view>
            <view class="spread-cells">
              <view wx:for="{{row.cells}}" wx:for-item="c" wx:key="key" class="spread-cell">
                <text class="spread-label">{{c.label}}</text>
                <text class="spread-value num">{{c.value}}</text>
              </view>
            </view>
          </view>
          <text class="t-mini">顺序：HP / 攻击 / 防御 / 特攻 / 特防 / 速度（0–32 SP）</text>
        </block>
      </view>

      <view class="foot-note">使用率为样本统计，不等同于强度排名</view>
    </block>
  </view>

  <view class="dock-space"></view>
</view>

<view wx:if="{{mon}}" class="dock">
  <view class="dock-inner">
    <view class="dock-fav {{fav ? 'on' : ''}}" bindtap="toggleFav" hover-class="press-hover">
      {{fav ? '★' : '☆'}}
    </view>
    <view class="btn btn-primary grow" bindtap="openTeams" hover-class="press-hover">加入队伍</view>
  </view>
</view>

<sheet show="{{sheet}}" title="加入队伍" bind:close="closeSheet">
  <view
    wx:for="{{teams}}"
    wx:key="id"
    class="sheet-row"
    data-id="{{item.id}}"
    bindtap="pickTeam"
    hover-class="press-hover"
  >
    <view class="grow">
      <text class="sheet-row-name ellipsis">{{item.name}}</text>
      <text class="t-mini">{{item.count}} / 6 只{{item.has ? ' · 已有' : ''}}</text>
    </view>
    <text class="sheet-row-state {{item.full || item.has ? 'off' : ''}}">{{item.full ? '已满' : item.has ? '已有' : '加入'}}</text>
  </view>

  <view wx:if="{{!teams.length}}" class="t-sub sheet-empty">还没有队伍，先创建一支吧</view>

  <view class="sheet-gap"></view>
  <view class="btn btn-ghost" bindtap="createAndAdd" hover-class="press-hover">新建队伍并加入</view>
  <view class="sheet-gap"></view>
</sheet>
