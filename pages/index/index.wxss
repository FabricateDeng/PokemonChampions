/* 图鉴 · 宝可梦 / 招式 双视图（.mv / .sheet-* 共用样式见 app.wxss） */

.head {
  position: sticky;
  z-index: 20;
  padding: 12rpx 0 16rpx;
  background: var(--bg);
  border-bottom: 1rpx solid var(--line);
}

.seg-wrap {
  margin-top: 16rpx;
}

.chips {
  margin-top: 16rpx;
}

.filter {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  height: 64rpx;
  margin-top: 12rpx;
  padding: 0 20rpx;
  border-radius: var(--r-ctrl);
  background: var(--surface);
  border: 1rpx solid var(--line);
}

.filter-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.filter-name {
  font-size: 26rpx;
  color: var(--text);
  flex-shrink: 0;
}

.filter-badge {
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  line-height: 32rpx;
  text-align: center;
  color: var(--brand-ink);
  background: var(--brand);
  flex-shrink: 0;
}

.filter-sum {
  font-size: 24rpx;
  color: var(--text-3);
  min-width: 0;
}

/* ---------------------------------------------------------------- 计数行 */

.count-tag {
  margin-left: 4rpx;
  padding: 0 10rpx;
  height: 32rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  line-height: 32rpx;
  color: var(--brand);
  background: var(--brand-soft);
}

/* ---------------------------------------------------------------- 宝可梦网格 */

.grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.mon {
  display: flex;
  flex-direction: column;
  padding: 16rpx 16rpx 20rpx;
  border-radius: var(--r-card);
  background: var(--surface);
  border: 1rpx solid var(--line);
}

.mon-head {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-height: 56rpx;
}

.mon-dex {
  font-size: 22rpx;
  color: var(--text-3);
}

.mon-form {
  font-size: 22rpx;
  color: var(--brand);
  font-weight: 600;
}

.mon-star {
  margin-left: auto;
  width: 64rpx;
  height: 64rpx;
  margin-top: -12rpx;
  margin-right: -12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-size: 32rpx;
  line-height: 1;
  color: var(--text-3);
}

.mon-star.on {
  color: var(--brand);
}

.star-hover {
  background: var(--surface-2);
}

.mon-sprite {
  width: 148rpx;
  height: 148rpx;
  align-self: center;
  margin: 6rpx 0 14rpx;
}

.mon-name {
  font-size: 28rpx;
  line-height: 1.3;
  font-weight: 600;
  text-align: center;
  color: var(--text);
}

.mon-types {
  display: flex;
  justify-content: center;
  gap: 8rpx;
  margin-top: 10rpx;
  min-height: 36rpx;
}

/* ---------------------------------------------------------------- 筛选面板 */

.sheet-reset {
  margin: 8rpx 0 4rpx;
  height: 64rpx;
  border-radius: var(--r-ctrl);
  background: var(--danger-soft);
  color: var(--danger);
  font-size: 26rpx;
  line-height: 64rpx;
  text-align: center;
}
