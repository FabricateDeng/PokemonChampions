<nav-bar title="图鉴" />

<view class="page">
  <!-- 吸顶：搜索 + 视图切换 + 属性 + 筛选（R3.2） -->
  <view class="head" style="top:{{navTotalHeight}}px;">
    <view class="pad">
      <view class="search">
        <view class="search-icon"></view>
        <input
          class="search-input"
          value="{{query}}"
          placeholder="{{mode === 'mon' ? '搜索名称 / 属性 / 特性 / 招式' : '搜索招式名称或效果'}}"
          placeholder-class="ph"
          confirm-type="search"
          bindinput="onSearch"
        />
        <view wx:if="{{query}}" class="search-clear" bindtap="clearQuery" hover-class="press-hover">×</view>
      </view>

      <view class="seg-wrap">
        <segmented items="{{modes}}" active="{{mode}}" bind:change="onMode" />
      </view>

      <scroll-view class="rail chips" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="rail-inner">
          <view
            wx:for="{{typeList}}"
            wx:key="key"
            class="chip chip-sm {{typeKey === item.key ? 'chip-on' : ''}}"
            data-key="{{item.key}}"
            bindtap="onType"
            hover-class="press-hover"
          >
            <view class="chip-dot" style="background:{{item.color}};"></view>
            <text>{{item.name}}</text>
          </view>
        </view>
      </scroll-view>

      <view class="filter" bindtap="openFilter" hover-class="press-hover">
        <view class="filter-left">
          <text class="filter-name">筛选</text>
          <text wx:if="{{filterCount}}" class="filter-badge num">{{filterCount}}</text>
          <text class="filter-sum ellipsis">{{summary}}</text>
        </view>
        <view class="chev"></view>
      </view>
    </view>
  </view>

  <!-- 宝可梦视图 -->
  <block wx:if="{{mode === 'mon'}}">
    <view class="pad">
      <view class="count">
        <text class="count-num num">{{monCount}}</text>
        <text class="count-unit">只</text>
        <text wx:if="{{onlyFav}}" class="count-tag">收藏</text>
      </view>

      <view wx:if="{{monList.length}}" class="grid">
        <view
          wx:for="{{monList}}"
          wx:key="key"
          class="mon press"
          data-key="{{item.key}}"
          bindtap="openDetail"
          hover-class="press-hover"
        >
          <view class="mon-head">
            <text class="mon-dex num">{{item.dexLabel}}</text>
            <text wx:if="{{item.formShort}}" class="mon-form">{{item.formShort}}</text>
            <view
              class="mon-star {{item.fav ? 'on' : ''}}"
              data-key="{{item.key}}"
              catchtap="toggleFav"
              hover-class="star-hover"
            >{{item.fav ? '★' : '☆'}}</view>
          </view>

          <image class="mon-sprite" src="{{item.sprite}}" mode="aspectFit" lazy-load />

          <text class="mon-name ellipsis">{{item.name}}</text>
          <view class="mon-types">
            <view
              wx:for="{{item.typesInfo}}"
              wx:for-item="t"
              wx:key="key"
              class="tag"
              style="color:{{t.color}};background:{{t.bg}};"
            >{{t.name}}</view>
          </view>
        </view>
      </view>

      <empty-state
        wx:else
        icon="search"
        title="没有匹配的宝可梦"
        desc="换个关键词，或放宽属性与世代条件"
        actionText="清除筛选"
        bind:action="clearFilters"
      />

      <view wx:if="{{monList.length}}" class="foot-note">
        {{monHasMore ? '上滑加载更多' : '已显示全部 ' + monCount + ' 只'}}
      </view>
    </view>
  </block>

  <!-- 招式视图 -->
  <block wx:else>
    <view class="pad">
      <view class="count">
        <text class="count-num num">{{moveCount}}</text>
        <text class="count-unit">个招式</text>
      </view>

      <view wx:if="{{moveList.length}}" class="list">
        <view wx:for="{{moveList}}" wx:key="key" class="mv">
          <view class="mv-top">
            <text class="mv-name ellipsis">{{item.name}}</text>
            <view class="tag" style="color:{{item.typeColor}};background:{{item.typeBg}};">{{item.typeName}}</view>
            <text class="tag-plain">{{item.catName}}</text>
            <text wx:if="{{item.priorityText}}" class="mv-prio num">先制 {{item.priorityText}}</text>
          </view>
          <view class="mv-stats">
            <text class="mv-stat">威力 <text class="num strong">{{item.powerText}}</text></text>
            <text class="mv-stat">命中 <text class="num strong">{{item.accText}}</text></text>
            <text class="mv-stat">PP <text class="num strong">{{item.pp}}</text></text>
            <text class="mv-learn">{{item.learnText}}</text>
          </view>
          <text class="mv-desc">{{item.desc}}</text>
        </view>
      </view>

      <empty-state
        wx:else
        icon="search"
        title="没有匹配的招式"
        desc="试试更换属性、分类，或换一个关键词"
        actionText="清除筛选"
        bind:action="clearFilters"
      />

      <view wx:if="{{moveList.length}}" class="foot-note">
        {{moveHasMore ? '上滑加载更多' : '已显示全部 ' + moveCount + ' 个招式'}}
      </view>
    </view>
  </block>

  <view class="foot-note">数据更新 {{dataUpdated}} · 非官方粉丝作品</view>

  <sheet show="{{sheet}}" title="筛选与排序" bind:close="closeFilter">
    <view wx:if="{{filterCount}}" class="sheet-reset" bindtap="clearFilters" hover-class="press-hover">
      清除全部筛选
    </view>

    <block wx:if="{{mode === 'mon'}}">
      <view class="sheet-sec">
        <text class="sheet-label">世代</text>
        <view class="chip-wrap">
          <view
            wx:for="{{genLabels}}"
            wx:key="*this"
            class="chip chip-sm {{genIndex === index ? 'chip-on' : ''}}"
            data-index="{{index}}"
            bindtap="onGen"
            hover-class="press-hover"
          >{{item}}</view>
        </view>
      </view>

      <view class="sheet-sec">
        <text class="sheet-label">形态</text>
        <view class="chip-wrap">
          <view
            wx:for="{{formLabels}}"
            wx:key="*this"
            class="chip chip-sm {{formIndex === index ? 'chip-on' : ''}}"
            data-index="{{index}}"
            bindtap="onForm"
            hover-class="press-hover"
          >{{item}}</view>
        </view>
      </view>

      <view class="sheet-sec">
        <text class="sheet-label">排序</text>
        <view class="chip-wrap">
          <view
            wx:for="{{monSorts}}"
            wx:key="*this"
            class="chip chip-sm {{sortIndex === index ? 'chip-on' : ''}}"
            data-index="{{index}}"
            bindtap="onSort"
            hover-class="press-hover"
          >{{item}}</view>
        </view>
      </view>

      <view class="sheet-sec">
        <text class="sheet-label">范围</text>
        <view class="chip-wrap">
          <view class="chip chip-sm {{onlyFav ? 'chip-on' : ''}}" bindtap="onOnlyFav" hover-class="press-hover">
            只显示收藏
          </view>
        </view>
      </view>
    </block>

    <block wx:else>
      <view class="sheet-sec">
        <text class="sheet-label">分类</text>
        <view class="chip-wrap">
          <view
            wx:for="{{moveCats}}"
            wx:key="key"
            class="chip chip-sm {{moveCatIndex === index ? 'chip-on' : ''}}"
            data-index="{{index}}"
            bindtap="onMoveCat"
            hover-class="press-hover"
          >{{item.name}}</view>
        </view>
      </view>

      <view class="sheet-sec">
        <text class="sheet-label">排序</text>
        <view class="chip-wrap">
          <view
            wx:for="{{moveSorts}}"
            wx:key="*this"
            class="chip chip-sm {{moveSortIndex === index ? 'chip-on' : ''}}"
            data-index="{{index}}"
            bindtap="onMoveSort"
            hover-class="press-hover"
          >{{item}}</view>
        </view>
      </view>
    </block>

    <view class="sheet-gap"></view>
  </sheet>
</view>
