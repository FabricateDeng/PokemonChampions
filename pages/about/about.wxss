.about-page {
  padding-bottom: 20rpx;
}

.about-hero {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 22rpx;
  padding: 46rpx 30rpx 38rpx;
  border-radius: 36rpx;
  overflow: hidden;
  background:
    radial-gradient(460rpx 300rpx at 50% 0%, rgba(255, 216, 77, 0.16), rgba(7, 11, 20, 0) 70%),
    linear-gradient(160deg, #141d2d, #0d1421);
  border: 1rpx solid rgba(255, 216, 77, 0.16);
}

.about-hero::after {
  content: "";
  position: absolute;
  width: 520rpx;
  height: 520rpx;
  top: -300rpx;
  right: -180rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(255, 216, 77, 0.08);
}

.about-mark {
  width: 104rpx;
  height: 104rpx;
  border-radius: 30rpx;
  background: linear-gradient(140deg, #ffe66f, #ffc531);
  color: #171204;
  font-size: 58rpx;
  font-weight: 900;
  line-height: 104rpx;
  text-align: center;
  box-shadow: 0 16rpx 40rpx rgba(255, 205, 50, 0.22);
}

.about-kicker {
  margin-top: 22rpx;
  font-size: 17rpx;
  letter-spacing: 3.4rpx;
  font-weight: 700;
  color: rgba(255, 216, 77, 0.68);
}

.about-title {
  margin-top: 6rpx;
  font-size: 48rpx;
  line-height: 58rpx;
  font-weight: 800;
  color: #fffdf5;
}

.about-sub {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 34rpx;
  color: #96a2b6;
  text-align: center;
}

.version-pill {
  margin-top: 20rpx;
  height: 38rpx;
  padding: 0 16rpx;
  border-radius: 19rpx;
  font-size: 16rpx;
  line-height: 36rpx;
  letter-spacing: 1.5rpx;
  color: #cbb96f;
  background: rgba(255, 216, 77, 0.06);
  border: 1rpx solid rgba(255, 216, 77, 0.16);
}

.stat-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 18rpx;
}

.stat-card {
  padding: 20rpx 6rpx 18rpx;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #111827;
  border: 1rpx solid rgba(255, 255, 255, 0.07);
}

.stat-num {
  font-size: 32rpx;
  line-height: 38rpx;
  font-weight: 800;
  color: #ffd84d;
  font-variant-numeric: tabular-nums;
}

.stat-label {
  margin-top: 3rpx;
  font-size: 17rpx;
  color: #798599;
}

.rank-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding: 20rpx 22rpx;
  border-radius: 22rpx;
  background:
    radial-gradient(300rpx 160rpx at 100% 0%, rgba(255, 216, 77, 0.14), transparent 70%),
    #111827;
  border: 1rpx solid rgba(255, 216, 77, 0.18);
}

.rank-entry-kicker {
  display: block;
  font-size: 14rpx;
  letter-spacing: 2rpx;
  font-weight: 700;
  color: rgba(255, 216, 77, 0.65);
}

.rank-entry-title {
  display: block;
  margin-top: 3rpx;
  font-size: 26rpx;
  font-weight: 750;
  color: #f2f6fc;
}

.rank-entry-link {
  font-size: 20rpx;
  color: #ffd84d;
}

.section {
  margin-top: 34rpx;
}

.section > .section-title {
  display: flex;
  margin-bottom: 16rpx;
}

.feature {
  display: flex;
  gap: 18rpx;
  padding: 22rpx;
  margin-bottom: 12rpx;
  border-radius: 24rpx;
  background: #111827;
  border: 1rpx solid rgba(255, 255, 255, 0.07);
}

.feature-no {
  width: 46rpx;
  height: 46rpx;
  flex-shrink: 0;
  border-radius: 13rpx;
  text-align: center;
  line-height: 46rpx;
  font-size: 18rpx;
  font-weight: 800;
  color: #ffd84d;
  background: rgba(255, 216, 77, 0.07);
  border: 1rpx solid rgba(255, 216, 77, 0.16);
}

.feature-content {
  flex: 1;
}

.feature-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #eef3fa;
}

.feature-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 21rpx;
  line-height: 34rpx;
  color: #96a2b5;
}

.info-card {
  padding: 8rpx 22rpx;
  border-radius: 24rpx;
  background: #111827;
  border: 1rpx solid rgba(255, 255, 255, 0.07);
}

.info-row {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 17rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.055);
}

.info-row:last-child {
  border-bottom: none;
}

.info-key {
  width: 136rpx;
  flex-shrink: 0;
  font-size: 20rpx;
  line-height: 32rpx;
  color: #748095;
}

.info-val {
  flex: 1;
  font-size: 21rpx;
  line-height: 32rpx;
  color: #c2ccda;
}

.info-note {
  display: block;
  margin-top: 13rpx;
  padding: 0 6rpx;
  font-size: 18rpx;
  line-height: 30rpx;
  color: #657186;
}

.source-card {
  padding: 20rpx 22rpx;
  margin-bottom: 12rpx;
  border-radius: 22rpx;
  background: #0f1724;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.source-name {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: #dfe6f1;
}

.source-url {
  display: block;
  margin-top: 4rpx;
  font-size: 19rpx;
  color: #65cfb9;
  word-break: break-all;
}

.source-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 20rpx;
  line-height: 32rpx;
  color: #8793a7;
}

.disclaimer {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 22rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.025);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  font-size: 19rpx;
  line-height: 32rpx;
  color: #748095;
}

.home-btn {
  margin-top: 34rpx;
  height: 82rpx;
  border-radius: 22rpx;
  text-align: center;
  line-height: 80rpx;
  font-size: 25rpx;
  font-weight: 700;
  color: #171204;
  background: linear-gradient(135deg, #ffe66f, #ffd23f);
  box-shadow: 0 14rpx 36rpx rgba(255, 205, 50, 0.18);
}

.about-foot {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 10rpx;
  padding: 30rpx 0 calc(30rpx + env(safe-area-inset-bottom));
  font-size: 16rpx;
  letter-spacing: 1.6rpx;
  color: #3f4a5d;
}

.about-foot-dot {
  color: #657187;
}
