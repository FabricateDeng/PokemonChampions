/* 我的：收藏 / 队伍 / 数据说明 / 关于 */

.fav-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12rpx;
}

.fav {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 12rpx 8rpx 14rpx;
  border-radius: var(--r-card);
  background: var(--surface);
  border: 1rpx solid var(--line);
}

.fav-sprite {
  width: 88rpx;
  height: 88rpx;
}

.fav-name {
  max-width: 100%;
  font-size: 22rpx;
  color: var(--text-2);
}

.row-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.row-card-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
}

/* ---------------------------------------------------------------- 数据说明 */

.info {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.info:last-child {
  border-bottom: none;
}

.info-label {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--text-3);
}

.info-value {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: var(--text-2);
  text-align: right;
}

.info-note {
  display: block;
  margin-top: 12rpx;
}

/* ---------------------------------------------------------------- 来源 */

.source {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.source:last-child {
  border-bottom: none;
}

.source-name {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text);
}

.source-url {
  font-size: 22rpx;
  color: var(--brand);
}

.disclaimer-gap {
  margin-top: 12rpx;
}
