.moves-hero {
  position: relative;
  margin-top: 18rpx;
  padding: 34rpx 30rpx 26rpx;
  border-radius: 34rpx;
  overflow: hidden;
  background:
    radial-gradient(600rpx 300rpx at 100% 0%, rgba(77, 224, 193, 0.16), rgba(7, 11, 20, 0) 70%),
    linear-gradient(145deg, rgba(77, 224, 193, 0.08), rgba(15, 22, 35, 0.94) 62%),
    #101827;
  border: 1rpx solid rgba(77, 224, 193, 0.15);
}

.moves-hero-glow {
  position: absolute;
  right: -80rpx;
  top: -100rpx;
  width: 340rpx;
  height: 340rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(77, 224, 193, 0.16);
  box-shadow: 0 0 90rpx rgba(77, 224, 193, 0.05);
}

.moves-kicker {
  font-size: 17rpx;
  letter-spacing: 3rpx;
  font-weight: 700;
  color: rgba(77, 224, 193, 0.75);
}

.moves-title {
  display: block;
  margin-top: 6rpx;
  font-size: 50rpx;
  line-height: 1.18;
  font-weight: 800;
  color: #f4fffc;
}

.moves-sub {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 34rpx;
  color: #93a1b5;
}

.moves-stats {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding: 14rpx 4rpx;
  border-radius: 18rpx;
  background: rgba(7, 11, 20, 0.35);
  border: 1rpx solid rgba(255, 255, 255, 0.055);
}

.moves-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.moves-stat-sep {
  width: 1rpx;
  height: 38rpx;
  background: rgba(255, 255, 255, 0.08);
}

.moves-num {
  font-size: 32rpx;
  line-height: 38rpx;
  font-weight: 800;
  color: #b8ffef;
  font-variant-numeric: tabular-nums;
}

.moves-label {
  margin-top: 2rpx;
  font-size: 17rpx;
  color: #728096;
}

.search-box {
  height: 82rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
  padding: 0 20rpx;
  border-radius: 22rpx;
  background: #111827;
  border: 1rpx solid rgba(255, 255, 255, 0.09);
}

.search-icon {
  position: relative;
  width: 24rpx;
  height: 24rpx;
  border: 3rpx solid #7d899d;
  border-radius: 50%;
  flex-shrink: 0;
}

.search-icon::after {
  content: "";
  position: absolute;
  width: 12rpx;
  height: 3rpx;
  right: -8rpx;
  bottom: -4rpx;
  background: #7d899d;
  border-radius: 2rpx;
  transform: rotate(45deg);
}

.search-input {
  flex: 1;
  height: 82rpx;
  font-size: 25rpx;
}

.search-placeholder {
  color: #69758a;
  font-size: 24rpx;
}

.search-clear {
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  text-align: center;
  line-height: 40rpx;
  font-size: 28rpx;
  color: #aeb8c9;
  background: rgba(255, 255, 255, 0.07);
}

.type-rail {
  width: calc(100% + 56rpx);
  height: 62rpx;
  margin-left: -28rpx;
  margin-top: 18rpx;
}

.type-rail-inner {
  display: inline-flex;
  gap: 11rpx;
  padding: 2rpx 28rpx 4rpx;
}

.type-chip {
  height: 52rpx;
  padding: 0 18rpx;
  border-radius: 17rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.09);
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 21rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.type-dot {
  width: 9rpx;
  height: 9rpx;
  border-radius: 50%;
}

.filter-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 18rpx;
}

.cat-row {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.cat-chip {
  height: 50rpx;
  padding: 0 13rpx;
  border-radius: 15rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 19rpx;
  color: #a1adbf;
  background: rgba(255, 255, 255, 0.045);
  border: 1rpx solid rgba(255, 255, 255, 0.075);
}

.cat-chip.active {
  color: #10130a;
  background: #4de0c1;
  border-color: #4de0c1;
}

.cat-count {
  font-size: 15rpx;
  opacity: 0.56;
  font-variant-numeric: tabular-nums;
}

.sort-chip {
  height: 50rpx;
  padding: 0 14rpx;
  border-radius: 15rpx;
  display: flex;
  align-items: center;
  gap: 9rpx;
  font-size: 19rpx;
  color: #aab5c6;
  background: rgba(255, 255, 255, 0.045);
  border: 1rpx solid rgba(255, 255, 255, 0.075);
  flex-shrink: 0;
}

.chevron {
  width: 9rpx;
  height: 9rpx;
  margin-top: -3rpx;
  border-right: 2rpx solid currentColor;
  border-bottom: 2rpx solid currentColor;
  transform: rotate(45deg);
  opacity: 0.65;
}

.result-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding: 0 4rpx 14rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.result-left {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.result-count {
  font-size: 38rpx;
  line-height: 42rpx;
  font-weight: 800;
  color: #4de0c1;
  font-variant-numeric: tabular-nums;
}

.result-unit {
  font-size: 20rpx;
  color: #7d899d;
}

.result-hint {
  font-size: 19rpx;
  color: #6f7b8f;
}

.clear-filter {
  height: 44rpx;
  padding: 0 14rpx;
  border-radius: 12rpx;
  font-size: 18rpx;
  line-height: 42rpx;
  color: #ff9aa4;
  background: rgba(255, 92, 108, 0.07);
  border: 1rpx solid rgba(255, 92, 108, 0.2);
}

.move-list {
  padding-top: 16rpx;
}

.move-card {
  position: relative;
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 12rpx;
  padding: 19rpx 15rpx 19rpx 23rpx;
  border-radius: 22rpx;
  background: linear-gradient(170deg, #131c2c, #0e1521);
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  overflow: hidden;
}

.move-card.expanded {
  border-color: rgba(77, 224, 193, 0.22);
  background: #0f1824;
}

.move-type-bar {
  position: absolute;
  left: 0;
  top: 17rpx;
  bottom: 17rpx;
  width: 6rpx;
  border-radius: 0 6rpx 6rpx 0;
}

.move-content {
  flex: 1;
  min-width: 0;
}

.move-line1 {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
}

.move-name {
  font-size: 28rpx;
  line-height: 36rpx;
  font-weight: 700;
  color: #f0f5fb;
}

.move-type,
.move-cat {
  height: 30rpx;
  padding: 0 9rpx;
  border-radius: 8rpx;
  font-size: 16rpx;
  line-height: 30rpx;
  font-weight: 650;
}

.move-prio {
  height: 30rpx;
  padding: 0 8rpx;
  border-radius: 8rpx;
  font-size: 15rpx;
  line-height: 30rpx;
  color: #ffd84d;
  background: rgba(255, 216, 77, 0.07);
}

.move-line2 {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 9rpx;
  font-size: 19rpx;
  color: #6f7c91;
}

.move-stat {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.move-num {
  color: #bdc8d8;
  font-weight: 650;
  font-variant-numeric: tabular-nums;
}

.learn-count {
  margin-left: auto;
  font-size: 17rpx;
  color: #61cdb7;
  background: rgba(77, 224, 193, 0.07);
  padding: 3rpx 9rpx;
  border-radius: 8rpx;
}

.move-desc {
  margin-top: 13rpx;
  padding-top: 13rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
  font-size: 22rpx;
  line-height: 36rpx;
  color: #9eabbf;
}

.move-expand {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
  border-radius: 50%;
  text-align: center;
  line-height: 38rpx;
  font-size: 27rpx;
  color: #8d99ac;
  background: rgba(255, 255, 255, 0.055);
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 100rpx;
}

.empty-icon {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  text-align: center;
  line-height: 132rpx;
  font-size: 58rpx;
  color: #4de0c1;
  border: 2rpx solid rgba(77, 224, 193, 0.18);
  background: rgba(77, 224, 193, 0.04);
}

.empty-title {
  margin-top: 30rpx;
  font-size: 29rpx;
  font-weight: 700;
  color: #dfe6f1;
}

.empty-sub {
  margin-top: 9rpx;
  font-size: 22rpx;
  color: #788499;
}

.empty-btn {
  margin-top: 26rpx;
  height: 62rpx;
  padding: 0 26rpx;
  border-radius: 17rpx;
  font-size: 22rpx;
  line-height: 60rpx;
  color: #4de0c1;
  background: rgba(77, 224, 193, 0.07);
  border: 1rpx solid rgba(77, 224, 193, 0.24);
}

.list-foot {
  padding: 30rpx 0 8rpx;
  text-align: center;
}

.list-foot-text {
  font-size: 19rpx;
  color: #596579;
}

.page-note {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 9rpx;
  padding: 16rpx 0 calc(38rpx + env(safe-area-inset-bottom));
  font-size: 17rpx;
  color: #404b5e;
}

.page-note-dot {
  color: #657187;
}
