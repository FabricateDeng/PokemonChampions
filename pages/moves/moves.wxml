<nav-bar title="招式库" back="{{true}}" />

<view class="page">
  <view class="page-pad">
    <view class="moves-hero">
      <view class="moves-hero-glow"></view>
      <text class="moves-kicker">MOVE DEX</text>
      <text class="moves-title">招式库</text>
      <text class="moves-sub">按学习面浏览《宝可梦冠军》当前可用的招式</text>
      <view class="moves-stats">
        <view class="moves-stat"><text class="moves-num">{{meta.moveCount}}</text><text class="moves-label">招式</text></view>
        <view class="moves-stat-sep"></view>
        <view class="moves-stat"><text class="moves-num">{{meta.typeCount}}</text><text class="moves-label">属性</text></view>
        <view class="moves-stat-sep"></view>
        <view class="moves-stat"><text class="moves-num">{{meta.abilityCount}}</text><text class="moves-label">特性</text></view>
      </view>
    </view>

    <view class="search-box">
      <view class="search-icon"></view>
      <input
        class="search-input"
        value="{{query}}"
        placeholder="搜索招式名称或效果"
        placeholder-class="search-placeholder"
        confirm-type="search"
        bindinput="onSearchInput"
      />
      <view wx:if="{{query}}" class="search-clear" bindtap="clearSearch">×</view>
    </view>

    <scroll-view class="type-rail" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="type-rail-inner">
        <view
          wx:for="{{typeList}}"
          wx:key="key"
          class="type-chip"
          data-key="{{item.key}}"
          bindtap="onTypeTap"
          style="background:{{typeKey === item.key ? item.color : 'rgba(255,255,255,0.045)'}};border-color:{{typeKey === item.key ? item.color : 'rgba(255,255,255,0.09)'}};color:{{typeKey === item.key ? item.textOn : '#c9d2e0'}};"
        >
          <view wx:if="{{item.key !== 'all'}}" class="type-dot" style="background:{{typeKey === item.key ? item.textOn : item.color}};"></view>
          <text>{{item.name}}</text>
        </view>
      </view>
    </scroll-view>

    <view class="filter-row">
      <view class="cat-row">
        <view
          wx:for="{{catChips}}"
          wx:key="key"
          class="cat-chip {{cat === item.key ? 'active' : ''}}"
          data-cat="{{item.key}}"
          bindtap="onCatTap"
        >
          <text>{{item.name}}</text>
          <text class="cat-count">{{item.count}}</text>
        </view>
      </view>

      <picker mode="selector" range="{{sortOptions}}" value="{{sortIndex}}" bindchange="onSortChange">
        <view class="sort-chip">
          <text>{{sortLabel}}</text>
          <view class="chevron"></view>
        </view>
      </picker>
    </view>

    <view class="result-bar">
      <view class="result-left">
        <text class="result-count">{{resultCount}}</text>
        <text class="result-unit">个招式</text>
      </view>
      <view wx:if="{{hasFilters}}" class="clear-filter" bindtap="clearFilters">清除筛选</view>
      <text wx:else class="result-hint">按{{sortLabel}}排序</text>
    </view>
  </view>

  <view wx:if="{{!empty}}" class="move-list page-pad">
    <view
      wx:for="{{visibleMoves}}"
      wx:key="key"
      class="move-card {{expandedKey === item.key ? 'expanded' : ''}}"
      data-key="{{item.key}}"
      bindtap="toggleMove"
    >
      <view class="move-type-bar" style="background:{{item.typeColor}};"></view>
      <view class="move-content">
        <view class="move-line1">
          <text class="move-name">{{item.name}}</text>
          <view class="move-type" style="color:{{item.typeColor}};background:{{item.typeBg}};">{{item.typeName}}</view>
          <view class="move-cat" style="color:{{item.catColor}};background:{{item.catBg}};">{{item.catName}}</view>
          <text wx:if="{{item.priorityText}}" class="move-prio">{{item.priorityText}}</text>
        </view>
        <view class="move-line2">
          <text class="move-stat">威力 <text class="move-num">{{item.powerText}}</text></text>
          <text class="move-stat">命中 <text class="move-num">{{item.accText}}</text></text>
          <text class="move-stat">PP <text class="move-num">{{item.pp}}</text></text>
          <text class="learn-count">{{item.learnCount}} 只可学</text>
        </view>
        <view wx:if="{{expandedKey === item.key}}" class="move-desc">{{item.desc || '暂无招式说明。'}}</view>
      </view>
      <view class="move-expand">{{expandedKey === item.key ? '−' : '+'}}</view>
    </view>
  </view>

  <view wx:if="{{empty}}" class="empty page-pad">
    <view class="empty-icon">⌕</view>
    <text class="empty-title">没有找到匹配的招式</text>
    <text class="empty-sub">试试更换属性、分类或关键词</text>
    <view class="empty-btn press" bindtap="clearFilters" hover-class="press-hover">清除全部筛选</view>
  </view>

  <view wx:if="{{!empty}}" class="list-foot">
    <text wx:if="{{hasMore}}" class="list-foot-text">继续上滑，加载更多</text>
    <text wx:else class="list-foot-text">已展示全部 {{resultCount}} 个招式</text>
  </view>

  <view class="page-note">
    <text>PP 与威力以《宝可梦冠军》为准</text>
    <text class="page-note-dot">·</text>
    <text>更新 2026.11</text>
  </view>
</view>
