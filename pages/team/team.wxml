<nav-bar title="队伍编辑" back="{{true}}" />

<view class="page">
  <view class="pad">
    <view class="head">
      <input
        class="team-name"
        value="{{name}}"
        maxlength="20"
        placeholder="队伍名称"
        placeholder-class="ph"
        bindinput="onNameInput"
        bindblur="onNameBlur"
      />
      <view class="more" bindtap="openMenu" hover-class="press-hover">⋯</view>
    </view>
    <text class="t-mini">{{count}} / 6 只 · 修改自动保存</text>

    <view class="slots">
      <block wx:for="{{slots}}" wx:key="index">
        <view
          wx:if="{{item.empty}}"
          class="slot-empty"
          data-slot="{{item.index}}"
          bindtap="addMember"
          hover-class="press-hover"
        >
          <view class="slot-plus"></view>
          <text class="slot-empty-text">添加第 {{item.index + 1}} 位</text>
        </view>

        <view
          wx:else
          class="slot"
          data-slot="{{item.index}}"
          bindtap="editMember"
          hover-class="press-hover"
        >
          <image class="slot-sprite" src="{{item.sprite}}" mode="aspectFit" lazy-load />

          <view class="slot-main">
            <view class="slot-title">
              <text class="slot-name ellipsis">{{item.name}}</text>
              <view class="slot-types">
                <view
                  wx:for="{{item.typesInfo}}"
                  wx:for-item="t"
                  wx:key="key"
                  class="tag"
                  style="color:{{t.color}};background:{{t.bg}};"
                >{{t.name}}</view>
              </view>
            </view>
            <text class="slot-config ellipsis">{{item.abilityName}} · {{item.itemName}} · {{item.natureName}}</text>
            <text class="slot-moves ellipsis {{item.movesEmpty ? 'text-3' : ''}}">{{item.moveText}}</text>
          </view>

          <view class="slot-go"></view>
        </view>
      </block>
    </view>

    <view class="dock-space"></view>
  </view>
</view>

<view class="dock">
  <view class="dock-inner">
    <view
      class="btn btn-primary grow {{canCalc ? '' : 'btn-disabled'}}"
      bindtap="goCalc"
      hover-class="press-hover"
    >伤害计算</view>
  </view>
</view>

<sheet show="{{sheet}}" title="队伍操作" bind:close="closeMenu">
  <view class="btn btn-danger menu-btn" bindtap="deleteTeam" hover-class="press-hover">删除队伍</view>
  <view class="t-mini menu-hint">删除后配置无法恢复</view>
  <view class="sheet-gap"></view>
</sheet>
