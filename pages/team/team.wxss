/* 队伍编辑 */

.head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 0 4rpx;
}

.team-name {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text);
}

.more {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: var(--text-2);
  font-size: 36rpx;
  line-height: 1;
}

.slots {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 20rpx;
}

.slot-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 88rpx;
  border-radius: var(--r-card);
  border: 1rpx dashed var(--line-strong);
  color: var(--text-3);
}

.slot-plus {
  position: relative;
  width: 28rpx;
  height: 28rpx;
}

.slot-plus::before,
.slot-plus::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  background: var(--text-3);
  border-radius: 2rpx;
  transform: translate(-50%, -50%);
}

.slot-plus::before {
  width: 28rpx;
  height: 3rpx;
}

.slot-plus::after {
  width: 3rpx;
  height: 28rpx;
}

.slot-empty-text {
  font-size: 26rpx;
}

.slot {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx;
  border-radius: var(--r-card);
  background: var(--surface);
  border: 1rpx solid var(--line);
}

.slot-sprite {
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
}

.slot-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.slot-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.slot-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  max-width: 220rpx;
}

.slot-types {
  display: flex;
  gap: 6rpx;
  flex-shrink: 0;
}

.slot-config {
  font-size: 24rpx;
  color: var(--text-2);
}

.slot-moves {
  font-size: 23rpx;
  color: var(--text-3);
}

.slot-go {
  width: 16rpx;
  height: 16rpx;
  flex-shrink: 0;
  border-top: 3rpx solid var(--text-3);
  border-right: 3rpx solid var(--text-3);
  transform: rotate(45deg);
}

.menu-btn {
  margin-top: 8rpx;
}

.menu-hint {
  margin-top: 8rpx;
  text-align: center;
}
