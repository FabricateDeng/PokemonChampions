/* 选择宝可梦 */

.head {
  position: sticky;
  z-index: 20;
  padding: 12rpx 0 8rpx;
  background: var(--bg);
  border-bottom: 1rpx solid var(--line);
}

.chips {
  margin-top: 16rpx;
  margin-bottom: 8rpx;
}

.pick-badge {
  flex-shrink: 0;
  height: 44rpx;
  padding: 0 14rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
  line-height: 44rpx;
  color: var(--text-3);
  background: var(--surface-2);
}

.pick-add {
  position: relative;
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
  border-radius: 50%;
  border: 1rpx solid var(--brand-line);
  background: var(--brand-soft);
}

.pick-add::before,
.pick-add::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  background: var(--brand);
  border-radius: 2rpx;
  transform: translate(-50%, -50%);
}

.pick-add::before {
  width: 20rpx;
  height: 3rpx;
}

.pick-add::after {
  width: 3rpx;
  height: 20rpx;
}
