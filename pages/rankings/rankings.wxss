.rankings-page {
  padding-bottom: 20rpx;
}

.rank-hero {
  position: relative;
  margin-top: 18rpx;
  padding: 32rpx 28rpx 26rpx;
  border-radius: 36rpx;
  overflow: hidden;
  background:
    radial-gradient(520rpx 280rpx at 100% 0%, rgba(255, 216, 77, 0.18), rgba(7, 11, 20, 0) 72%),
    radial-gradient(420rpx 260rpx at 0% 100%, rgba(77, 224, 193, 0.1), rgba(7, 11, 20, 0) 70%),
    linear-gradient(150deg, #141d2d, #0c1320);
  border: 1rpx solid rgba(255, 216, 77, 0.16);
}

.rank-hero-glow {
  position: absolute;
  width: 300rpx;
  height: 300rpx;
  right: -130rpx;
  top: -150rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(255, 216, 77, 0.13);
  box-shadow: 0 0 80rpx rgba(255, 216, 77, 0.05);
}

.rank-hero-head {
  position: relative;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.rank-kicker {
  font-size: 17rpx;
  letter-spacing: 3.2rpx;
  font-weight: 700;
  color: rgba(255, 216, 77, 0.72);
}

.rank-title {
  display: block;
  margin-top: 6rpx;
  font-size: 50rpx;
  line-height: 1.16;
  font-weight: 800;
  color: #fffdf5;
}

.rank-crown {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  text-align: center;
  line-height: 72rpx;
  font-size: 19rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
  color: #171204;
  background: linear-gradient(140deg, #ffe66f, #ffc531);
  box-shadow: 0 10rpx 28rpx rgba(255, 205, 50, 0.18);
}

.rank-sub {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 32rpx;
  color: #96a2b6;
}

.format-switch {
  display: flex;
  gap: 10rpx;
  margin-top: 22rpx;
  padding: 6rpx;
  border-radius: 18rpx;
  background: rgba(7, 11, 20, 0.42);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.format-btn {
  position: relative;
  flex: 1;
  height: 62rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border-radius: 14rpx;
  font-size: 24rpx;
  font-weight: 650;
  color: #8793a7;
}

.format-btn.active {
  color: #171204;
  background: linear-gradient(135deg, #ffe66f, #ffd23f);
  box-shadow: 0 6rpx 18rpx rgba(255, 205, 50, 0.16);
}

.format-active-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #171204;
}

.rank-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 7rpx;
  margin-top: 18rpx;
  font-size: 19rpx;
  line-height: 28rpx;
  color: #748095;
}

.rank-meta-source {
  color: #baa95e;
}

.rank-meta-dot {
  color: #4f5b6e;
}

.podium {
  display: flex;
  align-items: flex-end;
  gap: 10rpx;
  margin-top: 26rpx;
}

.podium-card {
  position: relative;
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 10rpx 18rpx;
  border-radius: 24rpx;
  background: #111827;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  overflow: hidden;
}

.podium-card.first {
  padding-top: 38rpx;
  padding-bottom: 24rpx;
  border-color: rgba(255, 216, 77, 0.4);
  background:
    radial-gradient(260rpx 180rpx at 50% 0%, rgba(255, 216, 77, 0.2), transparent 70%),
    linear-gradient(170deg, #1b2432, #111827);
  box-shadow: 0 16rpx 40rpx rgba(255, 205, 50, 0.08);
  transform: translateY(-12rpx);
}

.podium-card.second {
  border-color: rgba(194, 207, 224, 0.2);
  background: linear-gradient(170deg, #171f2d, #111827);
}

.podium-card.third {
  border-color: rgba(205, 150, 99, 0.2);
  background: linear-gradient(170deg, #1a202b, #111827);
}

.podium-medal {
  position: absolute;
  left: 12rpx;
  top: 12rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  text-align: center;
  line-height: 36rpx;
  font-size: 17rpx;
  font-weight: 800;
  color: #111827;
  background: #ffd84d;
}

.podium-card.second .podium-medal {
  background: #c8d3e2;
}

.podium-card.third .podium-medal {
  background: #cd9663;
}

.podium-sprite {
  width: 128rpx;
  height: 128rpx;
  margin-top: 6rpx;
}

.podium-card.first .podium-sprite {
  width: 148rpx;
  height: 148rpx;
}

.podium-name {
  width: 100%;
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 30rpx;
  font-weight: 750;
  color: #f1f5fb;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.podium-types {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 5rpx;
  margin-top: 7rpx;
  min-height: 26rpx;
}

.podium-type {
  height: 26rpx;
  padding: 0 7rpx;
  border-radius: 7rpx;
  border: 1rpx solid;
  font-size: 14rpx;
  line-height: 26rpx;
  font-weight: 600;
}

.podium-pct {
  margin-top: 12rpx;
  font-size: 28rpx;
  line-height: 32rpx;
  font-weight: 800;
  color: #ffd84d;
  font-variant-numeric: tabular-nums;
}

.podium-card.second .podium-pct,
.podium-card.third .podium-pct {
  color: #dce4ef;
  font-size: 24rpx;
}

.podium-sub {
  margin-top: 2rpx;
  font-size: 15rpx;
  color: #657186;
}

.list-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 30rpx;
  padding: 0 4rpx 14rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.list-head-left {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.list-head-note {
  font-size: 18rpx;
  color: #6f7b8f;
}

.list-head-top {
  font-size: 18rpx;
  color: #7d899d;
}

.rank-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding-top: 14rpx;
}

.rank-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-height: 116rpx;
  padding: 14rpx 16rpx;
  border-radius: 20rpx;
  background: linear-gradient(170deg, #131c2b, #0f1623);
  border: 1rpx solid rgba(255, 255, 255, 0.065);
}

.rank-no {
  width: 42rpx;
  flex-shrink: 0;
  text-align: center;
  font-size: 24rpx;
  font-weight: 800;
  color: #77849a;
  font-variant-numeric: tabular-nums;
}

.rank-sprite {
  width: 82rpx;
  height: 82rpx;
  flex-shrink: 0;
}

.rank-info {
  flex: 1;
  min-width: 0;
}

.rank-name-line {
  display: flex;
  align-items: center;
  gap: 7rpx;
  min-width: 0;
}

.rank-name {
  font-size: 25rpx;
  line-height: 32rpx;
  font-weight: 700;
  color: #eef3fa;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rank-form {
  height: 25rpx;
  padding: 0 7rpx;
  border-radius: 7rpx;
  flex-shrink: 0;
  font-size: 13rpx;
  line-height: 25rpx;
  color: #d3b8ff;
  background: rgba(160, 110, 255, 0.1);
}

.rank-types {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 6rpx;
  margin-top: 6rpx;
}

.rank-type {
  height: 26rpx;
  padding: 0 8rpx;
  border-radius: 7rpx;
  border: 1rpx solid;
  font-size: 15rpx;
  line-height: 26rpx;
  font-weight: 600;
}

.rank-team {
  margin-left: 4rpx;
  font-size: 15rpx;
  color: #596579;
}

.rank-right {
  width: 154rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.rank-pct {
  font-size: 25rpx;
  line-height: 30rpx;
  font-weight: 800;
  color: #ffd84d;
  font-variant-numeric: tabular-nums;
}

.rank-bar {
  width: 100%;
  height: 8rpx;
  margin-top: 7rpx;
  border-radius: 8rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.06);
}

.rank-bar-fill {
  height: 100%;
  border-radius: 8rpx;
  background: linear-gradient(90deg, rgba(255, 216, 77, 0.45), #ffd84d);
}

.rank-sub {
  margin-top: 5rpx;
  font-size: 15rpx;
  color: #657186;
}

.rank-note {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 26rpx;
  padding: 20rpx 18rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.025);
  border: 1rpx solid rgba(255, 255, 255, 0.05);
  font-size: 18rpx;
  line-height: 29rpx;
  color: #677387;
}

.rank-note-source {
  color: #596579;
}

.rank-note-strong {
  color: #a8944c;
}

.rank-foot {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 9rpx;
  padding: 28rpx 0 calc(30rpx + env(safe-area-inset-bottom));
  font-size: 16rpx;
  letter-spacing: 1.2rpx;
  color: #3f4a5d;
}

.rank-foot-dot {
  color: #657187;
}
