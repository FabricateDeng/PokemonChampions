/* 使用率榜单 */

.head {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 16rpx 0 20rpx;
}

.scope-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.scope-count {
  font-size: 22rpx;
  color: var(--text-3);
  flex-shrink: 0;
}

.source {
  font-size: 24rpx;
  color: var(--text-3);
}

/* ---------------------------------------------------------------- TOP3 */

.top3 {
  display: flex;
  gap: 12rpx;
}

.top-card {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 16rpx 8rpx 20rpx;
  border-radius: var(--r-card);
  background: var(--surface);
  border: 1rpx solid var(--line);
}

.top-card.first {
  border-color: var(--brand-line);
  background: var(--brand-soft);
}

.top-rank {
  align-self: flex-start;
  padding-left: 4rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--text-3);
}

.top-card.first .top-rank {
  color: var(--brand);
}

.top-sprite {
  width: 104rpx;
  height: 104rpx;
}

.top-name {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text);
  max-width: 100%;
}

.top-pct {
  font-size: 24rpx;
  color: var(--text-2);
}

.top-card.first .top-pct {
  color: var(--brand);
  font-weight: 600;
}

/* ---------------------------------------------------------------- 4 名之后 */

.rk {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.rk:last-child {
  border-bottom: none;
}

.rk-no {
  width: 44rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--text-3);
  text-align: center;
}

.rk-sprite {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
}

.rk-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.rk-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text);
}

.rk-types {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.rk-right {
  width: 180rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
}

.rk-pct {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
}

.rk-bar {
  width: 100%;
}

.rk-extra {
  margin-left: 4rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

/* 未上榜：整体降一档，数字弱化 */
.rk.is-unranked .rk-name {
  color: var(--text-2);
  font-weight: 400;
}

.rk.is-unranked .rk-sprite {
  opacity: 0.72;
}

.rk-pct.muted {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--text-3);
}

.rk.is-unranked .bar-fill {
  background: var(--text-3);
  opacity: 0.5;
}
