<nav-bar title="使用率榜单" />

<view class="page">
  <view class="pad">
    <view class="head">
      <segmented items="{{formats}}" active="{{format}}" bind:change="onFormat" />
      <text class="source">{{sourceText}} · {{sampleText}}</text>
    </view>

    <view wx:if="{{top.length}}" class="top3">
      <view
        wx:for="{{top}}"
        wx:key="key"
        class="top-card {{index === 0 ? 'first' : ''}} press"
        data-key="{{item.key}}"
        bindtap="openMon"
        hover-class="press-hover"
      >
        <text class="top-rank num">{{item.rank}}</text>
        <image class="top-sprite" src="{{item.sprite}}" mode="aspectFit" lazy-load />
        <text class="top-name ellipsis">{{item.name}}</text>
        <text class="top-pct num">{{item.usageText}}</text>
      </view>
    </view>

    <view wx:if="{{rows.length}}" class="list">
      <view
        wx:for="{{rows}}"
        wx:key="key"
        class="rk"
        data-key="{{item.key}}"
        bindtap="openMon"
        hover-class="press-hover"
      >
        <text class="rk-no num">{{item.rank}}</text>
        <image class="rk-sprite" src="{{item.sprite}}" mode="aspectFit" lazy-load />

        <view class="rk-main">
          <text class="rk-name ellipsis">{{item.name}}</text>
          <view class="rk-types">
            <view
              wx:for="{{item.typesInfo}}"
              wx:for-item="t"
              wx:key="key"
              class="tag"
              style="color:{{t.color}};background:{{t.bg}};"
            >{{t.name}}</view>
            <text class="rk-extra num">{{item.extra}}</text>
          </view>
        </view>

        <view class="rk-right">
          <text class="rk-pct num">{{item.usageText}}</text>
          <view class="bar rk-bar">
            <view class="bar-fill" style="width:{{item.width}};"></view>
          </view>
        </view>
      </view>
    </view>

    <empty-state
      wx:else
      icon="ball"
      title="暂无榜单数据"
      desc="使用率数据需要联网获取，稍后重试或先浏览图鉴"
    />

    <view wx:if="{{count}}" class="foot-note">共 {{count}} 只 · {{note}}</view>
  </view>
</view>
