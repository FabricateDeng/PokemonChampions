.sh {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 300;
  pointer-events: none;
}

.sh-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  opacity: 0;
  transition: opacity 0.18s ease;
}

.sh-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  background: var(--surface, #131a24);
  border-radius: 28rpx 28rpx 0 0;
  border-top: 1rpx solid var(--line, rgba(255, 255, 255, 0.08));
  transform: translateY(102%);
  transition: transform 0.2s cubic-bezier(0.22, 0.61, 0.36, 1);
}

.sh-open {
  pointer-events: auto;
}

.sh-open .sh-mask {
  opacity: 1;
}

.sh-open .sh-panel {
  transform: translateY(0);
}

.sh-grip {
  width: 72rpx;
  height: 8rpx;
  margin: 16rpx auto 0;
  border-radius: 999rpx;
  background: var(--line-strong, rgba(255, 255, 255, 0.16));
}

.sh-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 16rpx 24rpx 8rpx;
}

.sh-title {
  font-size: 30rpx;
  line-height: 1.3;
  font-weight: 600;
  color: var(--text, #e8edf5);
}

.sh-done {
  height: 64rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  line-height: 64rpx;
  color: var(--brand, #f2c455);
  background: var(--brand-soft, rgba(242, 196, 85, 0.14));
}

.sh-body {
  max-height: 64vh;
  padding: 8rpx 24rpx 0;
}

.sh-safe {
  height: calc(24rpx + env(safe-area-inset-bottom));
}
