.nv {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: rgba(10, 14, 20, 0.96);
  border-bottom: 1rpx solid var(--line, rgba(255, 255, 255, 0.08));
}

.nv-inner {
  display: flex;
  align-items: center;
  /* right padding keeps content clear of the WeChat capsule button (R2.5) */
  padding: 0 200rpx 0 24rpx;
}

.nv-back {
  width: 64rpx;
  height: 64rpx;
  margin-right: 8rpx;
  margin-left: -8rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.nv-back-hover {
  background: var(--surface-2, #1a222e);
}

.nv-arrow {
  width: 22rpx;
  height: 22rpx;
  margin-left: 6rpx;
  border-left: 4rpx solid var(--text, #e8edf5);
  border-bottom: 4rpx solid var(--text, #e8edf5);
  transform: rotate(45deg);
  border-radius: 2rpx;
}

.nv-titles {
  display: flex;
  flex-direction: column;
  min-width: 0;
  gap: 2rpx;
}

.nv-title {
  font-size: 34rpx;
  line-height: 1.2;
  font-weight: 600;
  color: var(--text, #e8edf5);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nv-sub {
  font-size: 22rpx;
  line-height: 1.3;
  color: var(--text-3, #6a7585);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
