<view class="nv" style="padding-top:{{m.statusBarHeight}}px;">
  <view class="nv-inner" style="height:{{m.navBarHeight}}px;">
    <view
      wx:if="{{back}}"
      class="nv-back"
      hover-class="nv-back-hover"
      bindtap="goBack"
      aria-role="button"
      aria-label="返回"
    >
      <view class="nv-arrow"></view>
    </view>

    <view class="nv-titles">
      <text class="nv-title">{{title}}</text>
      <text wx:if="{{subtitle}}" class="nv-sub">{{subtitle}}</text>
    </view>
  </view>
</view>
<view class="nv-holder" style="height:{{m.navTotalHeight}}px;"></view>
