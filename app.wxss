page {
  background: #070b14;
  color: #f4f7fb;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  -webkit-font-smoothing: antialiased;
}

view,
text,
scroll-view,
image,
input,
picker,
button {
  box-sizing: border-box;
}

button {
  padding: 0;
  margin: 0;
  background: transparent;
  line-height: normal;
}

button::after {
  border: none;
}

input {
  color: #f4f7fb;
}

.page {
  min-height: 100vh;
  background:
    radial-gradient(900rpx 600rpx at 88% -8%, rgba(255, 216, 77, 0.11), rgba(7, 11, 20, 0) 68%),
    radial-gradient(720rpx 520rpx at -12% 16%, rgba(77, 224, 193, 0.08), rgba(7, 11, 20, 0) 70%),
    #070b14;
}

.page-pad {
  padding-left: 28rpx;
  padding-right: 28rpx;
}

.safe-bottom {
  padding-bottom: calc(36rpx + env(safe-area-inset-bottom));
}

.muted {
  color: #8a96ab;
}

.gold {
  color: #ffd84d;
}

.card {
  background: #111827;
  border: 1rpx solid rgba(255, 255, 255, 0.075);
  border-radius: 28rpx;
}

.press {
  transition: transform 0.12s ease, opacity 0.12s ease;
}

.press:active {
  transform: scale(0.985);
  opacity: 0.9;
}

.press-hover {
  transform: scale(0.985);
  opacity: 0.9;
}

.section-title {
  display: flex;
  align-items: center;
  gap: 14rpx;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 0.5rpx;
}

.section-title::before {
  content: "";
  width: 6rpx;
  height: 26rpx;
  border-radius: 6rpx;
  background: #ffd84d;
}

.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* Hide scrollbars for horizontal chip rails */
::-webkit-scrollbar {
  width: 0;
  height: 0;
  display: none;
}
